{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rinne layer-two user background snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of_date",
    "current_overview",
    "historical_overview",
    "sections",
    "daily_update",
    "uncertainty_warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2-atomic-background"
    },
    "as_of_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "current_overview": {
      "type": "string",
      "maxLength": 20000
    },
    "historical_overview": {
      "type": "string",
      "maxLength": 20000
    },
    "sections": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "items"],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "stable_identity",
              "current_life_state",
              "ongoing_projects_and_study",
              "future_plans_and_commitments",
              "preferences_and_habits",
              "important_people_and_relationships",
              "relationship_with_rinne",
              "values_and_support_preferences",
              "constraints_and_environment",
              "recent_changes",
              "historical_transitions",
              "unknowns_and_do_not_assume"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/background_item"
            }
          }
        }
      }
    },
    "daily_update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_date",
        "added_fact_ids",
        "updated_fact_ids",
        "superseded_fact_ids",
        "removed_fact_ids",
        "no_change",
        "summary"
      ],
      "properties": {
        "source_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "added_fact_ids": {
          "$ref": "#/$defs/fact_id_list"
        },
        "updated_fact_ids": {
          "$ref": "#/$defs/fact_id_list"
        },
        "superseded_fact_ids": {
          "$ref": "#/$defs/fact_id_list"
        },
        "removed_fact_ids": {
          "$ref": "#/$defs/fact_id_list"
        },
        "no_change": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "maxLength": 1200
        }
      }
    },
    "uncertainty_warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  },
  "$defs": {
    "fact_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,79}$"
    },
    "fact_id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fact_id"
      }
    },
    "background_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "statement",
        "status",
        "subject_scope",
        "temporal_class",
        "context_bucket",
        "expected_end_on",
        "review_after",
        "first_observed_on",
        "last_updated_on",
        "source_dates",
        "evidence_type",
        "evidence_excerpts",
        "evidence_history",
        "supersedes_fact_ids",
        "notes"
      ],
      "properties": {
        "fact_id": {
          "$ref": "#/$defs/fact_id"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "status": {
          "type": "string",
          "enum": ["active", "historical", "superseded", "uncertain"]
        },
        "subject_scope": {
          "type": "string",
          "enum": ["user", "user_rinne_relationship"]
        },
        "temporal_class": {
          "type": "string",
          "enum": ["persistent", "ongoing", "scheduled", "transient", "historical"]
        },
        "context_bucket": {
          "type": "string",
          "enum": ["current", "history"]
        },
        "expected_end_on": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "review_after": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "first_observed_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "last_updated_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "source_dates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "diary_explicit_user_statement",
            "diary_reported_event",
            "diary_interpretation"
          ]
        },
        "evidence_excerpts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320
          }
        },
        "evidence_history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_date", "evidence_type", "evidence_excerpts"],
            "properties": {
              "source_date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "evidence_type": {
                "type": "string",
                "enum": [
                  "diary_explicit_user_statement",
                  "diary_reported_event",
                  "diary_interpretation"
                ]
              },
              "evidence_excerpts": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {"type": "string", "minLength": 1, "maxLength": 320}
              }
            }
          }
        },
        "supersedes_fact_ids": {
          "$ref": "#/$defs/fact_id_list"
        },
        "notes": {
          "type": "string",
          "maxLength": 600
        }
      }
    }
  }
}
