{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Layer 2 v2 block render",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "block", "lines", "omitted"],
  "properties": {
    "schema_version": {"const": "2.0-layer2-v2-block"},
    "block": {"type": "string", "enum": ["1", "2", "3", "5", "6"]},
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source_fact_ids"],
        "properties": {
          "text": {"type": "string", "minLength": 2, "maxLength": 200},
          "source_fact_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {"type": "string", "minLength": 2, "maxLength": 40}
          }
        }
      }
    },
    "omitted": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "reason"],
        "properties": {
          "fact_id": {"type": "string", "minLength": 2, "maxLength": 40},
          "reason": {"type": "string", "minLength": 2, "maxLength": 100}
        }
      }
    }
  }
}
