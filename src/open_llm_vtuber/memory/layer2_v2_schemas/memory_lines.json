{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Layer 2 v2 memory lines",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lines"],
  "properties": {
    "schema_version": {"const": "2.0-layer2-v2-memory-lines"},
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memory_id", "mode", "text"],
        "properties": {
          "memory_id": {"type": "string", "minLength": 3, "maxLength": 40},
          "mode": {"type": "string", "enum": ["近", "久远"]},
          "text": {"type": "string", "minLength": 4, "maxLength": 200}
        }
      }
    }
  }
}
